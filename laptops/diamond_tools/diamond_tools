#!/usr/bin/env bash

# Diamond Tools for Robot Laptops

sudo_check() {
  if [[ ! $(sudo echo 0) ]]; then
    echo "Did not pass sudo check. Exiting."
    exit 1
  fi
}

SRC_DIR="/home/ros/repos/tuos_robotics"
UPDATES_AVAILABLE=false

update_src() {
  if id -nG "${USER}" | grep -qw "sudo"; then
    echo "Checking for updates..."
    cd $SRC_DIR
    
    # Get current commit before pulling
    local before=$(git rev-parse HEAD 2>/dev/null)
    
    git pull --quiet
    
    # Get commit after pulling
    local after=$(git rev-parse HEAD 2>/dev/null)
    
    if [[ "$before" != "$after" ]]; then
      echo "Updates available - new commits pulled"
      UPDATES_AVAILABLE=true
    else
      echo "No updates available"
      UPDATES_AVAILABLE=false
    fi
  else
    echo "Non-admin user, skipping updates..."
  fi
}

getx() {
  update_src

  if [[ "$UPDATES_AVAILABLE" != "true" ]]; then
    echo "No updates available - skipping script execution"
    return 0
  fi

  SCRIPT=$1
  COPY_SCRIPT="$SCRIPT-$(date +'%Y%m%d%H%M%S')"
  echo "[INFO]: Obtaining '$SCRIPT.sh' script..."
  
  cd $HOME/.diamond/diamond_tools/
  cp $SRC_DIR/laptops/diamond_tools/$SCRIPT.sh ./$COPY_SCRIPT.sh
  
  echo "[INFO]: Executing..."
  chmod +x $COPY_SCRIPT.sh && ./$COPY_SCRIPT.sh
}

if [[ $# -eq 0 ]]; then
  echo "No input command provided. Exiting."
  exit 1
else
  COMMAND=$1
fi

if [[ $(iwgetid -r) != "eduroam" ]]; then
  echo "Connecting to eduroam..."
  nmcli c up eduroam
fi

case $COMMAND in 
  setup|s)
    sudo_check
    getx laptop_setup
    ;;
  update|u)
    sudo_check
    getx update_tools
    ;;
  workspace|w)
    getx ros_ws
    ;;
  log|l)
    sudo_check # would be good to make this non sudo, but currenlty the logs aren't accessible to other users
    getx log_tools
    ;;
  *)
    echo "Not a valid input."
    exit 1
    ;;
esac
