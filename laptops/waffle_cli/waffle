# Terminal Prompt Colour Options:
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;93m'
BLUE='\033[1;34m'
MAGENTA='\033[0;95m'
CYAN='\033[0;96m'
IT='\033[3m'
NC='\033[0m'

USAGE="${IT}waffle${NC} command line interface for The University of Sheffield TurtleBot3
Waffles.

Usage: waffle [NUM] [COMMAND]

[NUM]     Numeric ID of the robot you are working with (a number between
          1 and 50) e.g. ${IT}dia-waffle[NUM]${NC}.

[COMMAND] options:
  pair    ${IT}Pair${NC} this laptop to the specified robot (dia-waffle[NUM]).
  sync    Manually ${IT}sync${NC}hronise both system clocks to a common NTP Server.
  term    Launch a (tmux) ${IT}term${NC}inal instance on the specified robot
          (dia-waffle[NUM]).
  ping    Look for the specified robot (dia-waffle[NUM]) on the network by
          ${IT}ping${NC}ing it.
  off     Shutdown the robot.
"

# Internal functions

ask() {
    local reply prompt
    prompt='y/n'
    echo -e -n "${YELLOW}[INPUT]${NC} $1 [$prompt] >> "
    read -r reply </dev/tty
    if [[ -z $reply ]]; then
        return 1;
    elif [ "$reply" == "y" ] || [ "$reply" == "Y" ]; then
        return 0;
    else
        return 1;
    fi
}

check-for-dialab() {
    SSID_NOW=$(iwgetid -r)
    if [[ $SSID_NOW != "DIA-LAB" ]]; then
        if [[ "$1" == "loud" ]]; then
            echo -e "${CYAN}[$laptop_id]${NC} You aren't connected to the 'DIA-LAB' WiFi network yet."
            echo -e "You need to be connected to this to run ROS"
            echo -e "(but you won't be able to access the internet)."
        fi
        if ask "Do you want to connect to DIA-LAB now?"; then
            echo -e "${CYAN}[$laptop_id]${NC} Connecting to DIA-LAB..."
            nmcli c up DIA-LAB > /dev/null
        else
            echo -e "${CYAN}[$laptop_id]${NC} OK, remember to do it later then!"
        fi
    fi
}

check-pairing() {
    wn=~/.diamond/waffle_number
    touch $wn
    if grep -qi "$WAFFLE_NO" $wn; then
        # local pairing looks OK.
        # now check the pairing on the waffle side too...
        robot_response=$(ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP 'bash -s' < /usr/local/bin/robot_pair_check.sh $LAPTOP_NO) 
        if [[ $robot_response == "confirm" ]]; then
            if [[ $1 == "loud" ]]; then
                echo -e "${GREEN}[dia-waffle$WAFFLE_NO]${NC} Robot-Laptop pairing verified."
            fi
        elif [[ $robot_response == "deny" ]]; then
            echo -e "${GREEN}[dia-waffle$WAFFLE_NO]${NC} ${RED}Invalid pairing.${NC}"
            exit 2
        else
            echo -e "${GREEN}[dia-waffle$WAFFLE_NO]${NC} ${RED}Unexpected error.${NC}"
            exit 2
        fi
    else
        echo -e "${CYAN}[$laptop_id] ${RED}DENIED: This laptop isn't paired with dia-waffle$WAFFLE_NO.${NC}" 
        exit 2
    fi
}

# CLI entry points:

pair() {
    echo -e "You are about to pair ${CYAN}dia-laptop$LAPTOP_NO${NC} with ${GREEN}dia-waffle$WAFFLE_NO${NC}."
    if ask "OK to continue?"; then
        echo -e "${CYAN}[$laptop_id]${NC} Pairing in progress (this will take a minute)..."

        if ! waffle_ping; then
            # failed to ping the robot.
            exit 1
        fi

        if [[ -f ${HOME}/.ssh/waffle_rsa && $(cat ${HOME}/.diamond/waffle_number) == $WAFFLE_NO ]]; then
            robot_response=$(ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP 'bash -s' < /usr/local/bin/robot_pair_check.sh $LAPTOP_NO 2>/dev/null)
            if [[ $robot_response == "confirm" ]]; then
                echo -e "${GREEN}dia-waffle$WAFFLE_NO${NC} is already paired with this laptop."
                exit 0
            fi
        fi

        # configuring ssh connection:
        mkdir -p ~/.ssh/
        rm -f ~/.ssh/waffle_rsa*
        ssh-keygen -t rsa -b 2048 -f ~/.ssh/waffle_rsa -q -N ""
        if ! ssh-copy-id -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP > /dev/null 2>&1; then
            echo -e "${RED}[ERROR]${NC} SSH key copy failed. Please verify the robot password and host key, then retry pairing."
            exit 1
        fi
        # verify the SSH key works
        if ! ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP echo "SSH key verified" > /dev/null 2>&1; then
            echo -e "${RED}[ERROR]${NC} SSH key verification failed. The key may not have been installed correctly."
            exit 1
        fi
        echo "$WAFFLE_NO" > ~/.diamond/waffle_number 
        ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP 'bash -s' < /usr/local/bin/robot_pairing.sh $LAPTOP_NO

        if [[ "$1" != "quick" && "$1" != "q" ]]; then
            sync
        fi
        check-pairing loud

        echo -e "${BLUE}Pairing complete.${NC}"
    else
        echo -e "${RED}Pairing cancelled.${NC}"
    fi
}

sync() {
    echo -e "${CYAN}[$laptop_id]${NC} Preparing to run an NTP update on both systems..."
    SSID_NOW=$(iwgetid -r)
    if [[ $SSID_NOW != "eduroam" ]]; then
        echo -e "${CYAN}[$laptop_id]${NC} Temporarily connecting to eduroam..."
        nmcli c up eduroam > /dev/null
        echo -e "${CYAN}[$laptop_id]${NC} Synchronising laptop OS to NTP Server..."
        sudo ntpdate ntp.ubuntu.com > /dev/null
        echo -e "${CYAN}[$laptop_id]${NC} Laptop time synchronisation complete."
        echo -e "${CYAN}[$laptop_id]${NC} Connecting back to $SSID_NOW..."
        nmcli c up $SSID_NOW > /dev/null
    else
        echo -e "${CYAN}[$laptop_id]${NC} Synchronising laptop OS to NTP Server..."
        sudo ntpdate ntp.ubuntu.com > /dev/null
        echo -e "${CYAN}[$laptop_id]${NC} Laptop time synchronisation complete."
    fi
    ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP 'bash -s' < /usr/local/bin/robot_sync.sh $LAPTOP_NO
}

term() {
    # check-for-dialab
    check-pairing loud
    echo -e "${CYAN}[$laptop_id]${NC} Logging in to dia-waffle$WAFFLE_NO..."
    ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP -t "tmux new-session -s robot || tmux attach-session -t robot"
}

off() {
    check-pairing
    if [[ "$1" == "quick" || "$1" == "q" ]]; then
        echo "Shutting down the robot now..."
        ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP -t "sudo poweroff"
    else
        if ask "Are you sure you want to shutdown ${GREEN}dia-waffle$WAFFLE_NO?${NC}"; then
            ssh -o IdentitiesOnly=yes -i ~/.ssh/waffle_rsa robot@$WAFFLE_IP -t "sudo poweroff"
        else
            echo -e "${RED}Shutdown cancelled.${NC}"
        fi
    fi
}

waffle_ping() {
    DEADLINE=30 # seconds
    COUNT=1 # number of answered pings to dictate success
    echo -e "${CYAN}[$laptop_id]${NC} Looking for ${GREEN}dia-waffle$WAFFLE_NO${NC} on the network."
    echo -e "    This may take up to ${DEADLINE} seconds..."
    # Courtesy of: https://unix.stackexchange.com/questions/184266/bash-ping-script-file-for-checking-host-availability
    # Attempt to ping for a total of DEADLINE seconds, with one ping per second (default interval, could be changed by adding `-i INTERVAL`).
    # As per the man page, ping will wait until the deadline has expired, OR until COUNT ping(s) are answered by the robot (dictated by `-c COUNT`), whichever comes first.
    if [[ ! $(ping -w ${DEADLINE} -c ${COUNT} ${WAFFLE_IP} &>/dev/null) ]]; then
        echo -e "${RED}[ERROR]${NC} Unable to detect ${GREEN}dia-waffle$WAFFLE_NO${NC} on the network. Is it definitely turned on?!"
        return 1
    else
        echo -e "${GREEN}dia-waffle$WAFFLE_NO${NC} was detected."
        return 0
    fi
    
    
}

# Main:

laptop_id=$(hostname)
LAPTOP_NO=$(hostname | grep -o -E '[0-9]+')
LAPTOP_NO=$((10#$LAPTOP_NO)) # remove any leading zeros

if [[ $# -eq 2 || $# -eq 3 ]]; then
    WAFFLE_NO=$((10#$1)) # remove any leading zeros
    COMMAND=$2
    OPTION=$3
else
    echo -e "$USAGE"
    if [ ! -f ~/.diamond/waffle_number ]; then
        paired_waffle=""
    else
        paired_waffle=$(cat ~/.diamond/waffle_number)
    fi
    if [[ "$paired_waffle" == "" ]]; then
        echo -e "This laptop (${CYAN}dia-laptop$LAPTOP_NO${NC}) is not currently paired with a robot."
    else
        echo -e "This laptop (${CYAN}dia-laptop$LAPTOP_NO${NC}) is currently paired with ${GREEN}dia-waffle$paired_waffle.${NC}"
    fi
    exit 0
fi

NUM_MSG="Not a valid Waffle number ([NUM] must be between 1 and 50)."
if [[ "$WAFFLE_NO" == "" ]]; then
    echo "$NUM_MSG"
    exit 2
elif (( $WAFFLE_NO >= 1 && $WAFFLE_NO <= 50 )); then
    WAFFLE_IP="192.168.139.$((100 + $WAFFLE_NO))"
    true
else
    echo "$NUM_MSG"
    exit 2
fi

echo "robot" > ~/.diamond/ros_mode # set the laptop to 'real-robot mode' (as opposed to 'simulation mode')

case $COMMAND in 
    pair|sync|term|off)
        echo -e "${BLUE}Running '$COMMAND' command${NC}..." 
        eval $COMMAND $OPTION
        ;;
    ping)
        waffle_ping
        ;;
    *) 
        echo -e "${RED}[INVALID INPUT]...${NC}"
        echo -e "$USAGE"
        exit 0
        ;;
esac
