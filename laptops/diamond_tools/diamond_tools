#!/usr/bin/env bash

# Diamond Tools for Robot Laptops:
# locate in /usr/local/bin/

sudo_check() {
  if [[ ! $(sudo echo 0) ]]; then
    echo "Did not pass sudo check. Exiting."
    exit
  fi
}

SRC_DIR="/home/laptop/repos/tuos_robotics"

update_src() {
  echo "Checking for updates..."
  cd $SRC_DIR && git pull --quiet
}

getx() {
  SCRIPT=$1
  COPY_SCRIPT="$SCRIPT-$(date +'%Y%m%d%H%M%S')"
  echo "[INFO]: Obtaining '$SCRIPT.sh' script..."
  
  cd $HOME/.tuos/diamond_tools/
  cp $SRC_DIR/laptops/diamond_tools/$SCRIPT.sh ./$COPY_SCRIPT.sh
  
  echo "[INFO]: Executing..."
  chmod +x $COPY_SCRIPT.sh && ./$COPY_SCRIPT.sh
}

if [[ $# -eq 0 ]]; then
  echo "No input command provided. Exiting."
  exit 1
else
  COMMAND=$1
fi

if [[ $(iwgetid -r) != "eduroam" ]]; then
  echo "Connecting to eduroam..."
  nmcli c up eduroam
fi

case $COMMAND in 
  setup)
    sudo_check
    update_src
    if [[ $# -eq 1 ]]; then
      SCRIPT=laptop_setup
    else
      SCRIPT=$2
    fi
    getx $SCRIPT
    ;;
  update)
    sudo_check
    update_src
    getx update_tools
    ;;
  workspace)
    getx ros_ws
    ;;
  *)
    echo "Not a valid input."
    exit 1
    ;;
esac
